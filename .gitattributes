# Normalize line endings to LF on checkin; checkout uses native on Windows
* text=auto eol=lf

# Explicit text files
*.md       text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.py       text eol=lf
*.sh       text eol=lf

# Binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.zip      binary
